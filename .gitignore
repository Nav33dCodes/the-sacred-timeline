# ==============================================================================
# THE SACRED TIMELINE — .gitignore
# "Some things are meant to be pruned." — the TVA, probably
# ==============================================================================

# ---------- Dependencies ------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
jspm_packages/
bower_components/

# Lockfiles: keep exactly one. This project uses npm, so package-lock.json is
# COMMITTED (do not ignore it). Ignore the others so a stray install can't
# smuggle a second source of truth into the repo.
yarn.lock
pnpm-lock.yaml
bun.lockb

# ---------- Build output ------------------------------------------------------
dist/
dist-ssr/
build/
out/
.output/
*.local

# Bundle analysis (written by `npm run build -- --mode analyze`)
stats.html
dist/stats.html

# Generated responsive images. Rebuilt automatically by the prebuild/predev
# hooks, so there's no reason to carry ~11MB of derivatives in git.
# NOTE: src/data/imageManifest.json IS committed — src/ imports it.
public/assets/derived/

# ---------- Caches ------------------------------------------------------------
.vite/
node_modules/.vite/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm/
.rollup.cache/
tsconfig.tsbuildinfo
*.tsbuildinfo

# ---------- Environment / secrets --------------------------------------------
# Never commit these. If an API key ever lands in this project, it lives here.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---------- Logs --------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ---------- Testing / coverage ------------------------------------------------
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# ---------- Hosting / CI ------------------------------------------------------
.vercel/
.netlify/
.firebase/
.wrangler/

# ---------- Editors -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.history/

# ---------- OS cruft ----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/

# ---------- Scratch -----------------------------------------------------------
# Anything you want to keep locally without committing it.
tmp/
temp/
scratch/
*.bak
*.orig
*.rej
TODO.local.md
